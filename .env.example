# Desarrollo: completar secretos localmente. Este archivo no contiene credenciales.
NODE_ENV=development
PORT=3001
# MongoDB local debe ser replica set; nunca reutilizar MONGO_URI de producción.
MONGO_URI=mongodb://127.0.0.1:27017/canchalibre_v2_test?replicaSet=rs0
JWT_SECRET=
JWT_ACCESS_SECRET=
FRONT_URL=http://localhost:8080
APP_BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:8080
# Credenciales MP de pruebas y secreto de Webhooks de esa misma aplicación.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_FEATURED_WEBHOOK_SECRET=
# Opcional: objeto JSON email de club -> secreto de su aplicación MP.
MP_CLUB_WEBHOOK_SECRETS=
# Envío de correo real únicamente a destinatarios de pruebas autorizados.
BREVO_API_KEY=
SMTP_FROM=
